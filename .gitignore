# .gitignore atualizado
# Mantém o repositório limpo de dependências, builds e arquivos sensíveis

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo / React Native
.expo/
.expo-shared/
android/
ios/
ios/Pods/
android/.gradle/
android/app/build/
android/app/*.keystore

# Build outputs
build/
dist/
web-build/

# Gradle
.gradle/
gradle/
local.properties
android/local.properties

# Xcode
*.xcworkspace
*.xcuserstate
DerivedData/
ios/build/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# IDEs and editors
.vscode/
.idea/
*.iml

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage and caches
coverage/
.nyc_output/
jest-cache/
/.cache/
metro-cache/

# Certificates and signing
*.keystore
*.jks
*.p12
*.pem
*.pfx

# Misc
.DS_Store
Thumbs.db
*.swp
*.swo
__pycache__/
*.sqlite

# Sentry / crash reporting
sentry.properties

# Expo credentials
credentials.json

# Storybook
storybook-static/

# Keep any necessary examples or templates in the repo
!.env.example

